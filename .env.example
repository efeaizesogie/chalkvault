# Copy to .env.local and fill in from Firebase console → Project settings → Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check: reCAPTCHA Enterprise site key (in the same Google Cloud project as Firebase).
VITE_APPCHECK_SITE_KEY=
# VITE_APPCHECK_PROVIDER=v3   # only if you use classic reCAPTCHA v3

# Local development only: a fixed App Check debug token registered in the Firebase console.
VITE_APPCHECK_DEBUG_TOKEN=
