rules_version = '2';

// Chalkvault v2: every school is a private tenant, run by its own rules.
// - Owners and admins manage everything in their school.
// - A form teacher sees the students, register and form records of their arm(s).
// - A subject teacher sees the students in arms where they teach, and only their own subjects' scores.
// - The school's policy (schools/{id}.policy) decides who takes attendance and who may manage students.
// - Published report cards live at results/{pin}; only someone holding the private PIN can read one.
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user's list of schools (names and roles, for the school picker).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Published results: readable by exact PIN only (no listing). Written by that school's owner or admins.
    match /results/{pin} {
      function adminOf(schoolId) {
        return request.auth != null
          && exists(/databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid))
          && get(/databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)).data.role in ['owner', 'admin'];
      }
      allow get: if true;
      allow list: if false;
      allow create: if adminOf(request.resource.data.schoolId) && request.resource.data.pin == pin;
      allow update: if adminOf(resource.data.schoolId) && request.resource.data.schoolId == resource.data.schoolId;
      allow delete: if adminOf(resource.data.schoolId);
    }

    match /schools/{schoolId} {
      function signedIn() { return request.auth != null; }
      function memberPath() { return /databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid); }
      function isMember() { return signedIn() && exists(memberPath()); }
      function me() { return get(memberPath()).data; }
      function isAdmin() { return isMember() && me().role in ['owner', 'admin']; }
      function isOwner() { return isMember() && me().role == 'owner'; }
      function schoolDoc() { return get(/databases/$(database)/documents/schools/$(schoolId)).data; }
      function policy() { return schoolDoc().get('policy', {}); }

      function formOf(classId) { return isMember() && classId in me().get('classIds', []); }
      function subjectIn(classId) { return isMember() && classId in me().get('subjectClassIds', []); }
      function teachesOffering(offeringId) { return isMember() && offeringId in me().get('offeringIds', []); }
      function seesClass(classId) { return isAdmin() || formOf(classId) || subjectIn(classId); }
      function managesStudents(classId) { return isAdmin() || (formOf(classId) && policy().get('teachersManageStudents', true) == true); }
      function invitePath(code) { return /databases/$(database)/documents/schools/$(schoolId)/invites/$(code); }

      allow read: if isMember();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.id == schoolId;
      allow update: if isAdmin()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.id == resource.data.id;
      allow delete: if isOwner();

      match /members/{uid} {
        allow read: if isMember();
        allow create: if signedIn() && request.auth.uid == uid && request.resource.data.uid == uid && (
            // The owner bootstraps their own membership right after creating the school.
            (schoolDoc().ownerId == uid && request.resource.data.role == 'owner')
            // Everyone else joins with an invite; role and assignments must match it exactly.
            || (request.resource.data.inviteCode is string
                && exists(invitePath(request.resource.data.inviteCode))
                && request.resource.data.role != 'owner'
                && request.resource.data.role == get(invitePath(request.resource.data.inviteCode)).data.role
                && request.resource.data.classIds == get(invitePath(request.resource.data.inviteCode)).data.classIds
                && request.resource.data.get('offeringIds', []) == get(invitePath(request.resource.data.inviteCode)).data.get('offeringIds', [])
                && request.resource.data.get('subjectClassIds', []) == get(invitePath(request.resource.data.inviteCode)).data.get('subjectClassIds', []))
          );
        // Admins manage staff; nobody can promote someone to owner, and only the owner changes the owner's record.
        allow update: if isAdmin()
          && request.resource.data.uid == resource.data.uid
          && (request.resource.data.role != 'owner' || resource.data.role == 'owner')
          && (resource.data.role != 'owner' || isOwner());
        allow delete: if (isAdmin() && resource.data.role != 'owner') || (isOwner() && uid == request.auth.uid);
      }

      // Invite codes are long random strings; whoever holds the link can read that one invite.
      match /invites/{code} {
        allow get: if signedIn();
        allow list: if isAdmin();
        allow create, delete: if isAdmin();
      }

      match /terms/{termId} {
        allow read: if isMember();
        allow write: if isAdmin();
      }

      // Arms (JSS 1A, Primary 5B...).
      match /classes/{classId} {
        allow read: if isMember();
        allow write: if isAdmin();
      }

      // A subject in an arm. A teacher may only add or remove themselves from teacherIds, and only for offerings assigned to them.
      match /offerings/{offeringId} {
        allow read: if isMember();
        allow create, delete: if isAdmin();
        allow update: if isAdmin()
          || (teachesOffering(offeringId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teacherIds']));
      }

      match /students/{studentId} {
        allow read: if resource == null || seesClass(resource.data.classId);
        allow create: if managesStudents(request.resource.data.classId);
        allow update: if managesStudents(resource.data.classId) && managesStudents(request.resource.data.classId);
        allow delete: if managesStudents(resource.data.classId);
      }

      // The form teacher's record per student per term: notes, the AI-drafted comment, the principal's comment.
      // Only owners and admins approve; an approved record is locked for teachers.
      match /records/{recordId} {
        allow read: if isAdmin() || (resource != null && formOf(resource.data.classId));
        allow create: if (isAdmin() || formOf(request.resource.data.classId))
          && (isAdmin() || request.resource.data.get('status', '') != 'approved');
        allow update: if (isAdmin() || (formOf(resource.data.classId) && formOf(request.resource.data.classId)))
          && (isAdmin() || (resource.data.get('status', '') != 'approved' && request.resource.data.get('status', '') != 'approved'));
        allow delete: if isAdmin() || (formOf(resource.data.classId) && resource.data.get('status', '') != 'approved');
      }

      // Scores and remarks per student per subject per term. Form teachers can read them to compile report cards.
      match /subjectRecords/{recordId} {
        allow read: if isAdmin() || (resource != null && (formOf(resource.data.classId) || teachesOffering(resource.data.offeringId)));
        allow create: if isAdmin() || teachesOffering(request.resource.data.offeringId);
        allow update: if isAdmin() || (teachesOffering(resource.data.offeringId) && request.resource.data.offeringId == resource.data.offeringId);
        allow delete: if isAdmin() || teachesOffering(resource.data.offeringId);
      }

      // Registers: per arm per day (form teacher) or per subject lesson per day (subject teacher), as the school chooses.
      match /attendance/{dayId} {
        allow read: if isAdmin() || (resource != null && (formOf(resource.data.classId) || teachesOffering(resource.data.get('offeringId', ''))));
        allow create, update: if isAdmin()
          || (policy().get('attendanceBy', 'form') == 'form' && request.resource.data.get('offeringId', '') == '' && formOf(request.resource.data.classId))
          || (policy().get('attendanceBy', 'form') == 'subject' && teachesOffering(request.resource.data.get('offeringId', '')));
        allow delete: if isAdmin();
      }

      // Notice board.
      match /notices/{noticeId} {
        allow read: if isMember();
        allow create, delete: if isAdmin();
      }

      // Audit ledger of AI requests: any member adds their own entries; admins read all, others their own.
      match /ledger/{entryId} {
        allow create: if isMember() && request.resource.data.uid == request.auth.uid;
        allow read: if isAdmin() || (isMember() && resource.data.uid == request.auth.uid);
        allow delete: if isAdmin();
      }
    }
  }
}
