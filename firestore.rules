rules_version = '2';

// Chalkvault: every school is a private tenant.
// - Only members can read a school.
// - Owners and admins manage everything in their school.
// - Teachers can only read and write students and records in the classes assigned to them.
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user's list of schools (just names and roles, for the school picker).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /schools/{schoolId} {
      function signedIn() { return request.auth != null; }
      function memberPath() { return /databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid); }
      function isMember() { return signedIn() && exists(memberPath()); }
      function me() { return get(memberPath()).data; }
      function isAdmin() { return isMember() && me().role in ['owner', 'admin']; }
      function isOwner() { return isMember() && me().role == 'owner'; }
      function teaches(classId) { return isMember() && classId in me().classIds; }
      function canClass(classId) { return isAdmin() || teaches(classId); }
      function schoolDoc() { return get(/databases/$(database)/documents/schools/$(schoolId)).data; }

      allow read: if isMember();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.id == schoolId;
      allow update: if isAdmin()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.id == resource.data.id;
      allow delete: if isOwner();

      match /members/{uid} {
        allow read: if isMember();
        // Owner bootstraps their own membership right after creating the school.
        allow create: if signedIn() && request.auth.uid == uid && (
            (schoolDoc().ownerId == uid && request.resource.data.role == 'owner')
            // A teacher or admin joins with a valid invite; role and classes must match the invite.
            || (request.resource.data.inviteCode is string
                && exists(/databases/$(database)/documents/schools/$(schoolId)/invites/$(request.resource.data.inviteCode))
                && request.resource.data.role == get(/databases/$(database)/documents/schools/$(schoolId)/invites/$(request.resource.data.inviteCode)).data.role
                && request.resource.data.classIds == get(/databases/$(database)/documents/schools/$(schoolId)/invites/$(request.resource.data.inviteCode)).data.classIds
                && request.resource.data.role != 'owner')
          ) && request.resource.data.uid == uid;
        // Admins manage staff, but nobody can promote someone to owner, and the owner can't be changed by others.
        allow update: if isAdmin()
          && request.resource.data.uid == resource.data.uid
          && (request.resource.data.role != 'owner' || resource.data.role == 'owner')
          && (resource.data.role != 'owner' || isOwner());
        allow delete: if (isAdmin() && resource.data.role != 'owner') || (isOwner() && uid == request.auth.uid);
      }

      // Invite codes are long random strings; whoever holds the link can read that one invite.
      match /invites/{code} {
        allow get: if signedIn();
        allow list: if isAdmin();
        allow create, delete: if isAdmin();
      }

      match /terms/{termId} {
        allow read: if isMember();
        allow write: if isAdmin();
      }

      match /classes/{classId} {
        allow read: if isMember();
        allow write: if isAdmin();
      }

      match /students/{studentId} {
        allow read: if isAdmin() || (resource != null && teaches(resource.data.classId));
        allow create: if canClass(request.resource.data.classId);
        // Teachers can edit their students but cannot move them to a class they don't teach.
        allow update: if canClass(resource.data.classId) && canClass(request.resource.data.classId);
        allow delete: if canClass(resource.data.classId);
      }

      // Notes, scores and report comments, one document per student per term.
      // Only owners and admins can approve; an approved record is locked for teachers.
      match /records/{recordId} {
        allow read: if isAdmin() || (resource != null && teaches(resource.data.classId));
        allow create: if canClass(request.resource.data.classId)
          && (isAdmin() || request.resource.data.get('status', '') != 'approved');
        allow update: if canClass(resource.data.classId) && canClass(request.resource.data.classId)
          && (isAdmin() || (resource.data.get('status', '') != 'approved' && request.resource.data.get('status', '') != 'approved'));
        allow delete: if isAdmin() || (canClass(resource.data.classId) && resource.data.get('status', '') != 'approved');
      }

      // Daily registers, one document per class per day.
      match /attendance/{dayId} {
        allow read: if isAdmin() || (resource != null && teaches(resource.data.classId));
        allow create: if canClass(request.resource.data.classId);
        allow update: if canClass(resource.data.classId) && request.resource.data.classId == resource.data.classId;
        allow delete: if isAdmin();
      }

      // Audit ledger of AI requests: any member can add their own entry; admins read all, others read their own.
      match /ledger/{entryId} {
        allow create: if isMember() && request.resource.data.uid == request.auth.uid;
        allow read: if isAdmin() || (isMember() && resource.data.uid == request.auth.uid);
        allow delete: if isAdmin();
      }
    }
  }
}
